# ========================================================
# HRep e-Request Portal Environment Configuration
# ========================================================

# App Environment: 'local' (development) or 'production' (Google Cloud)
APP_ENV=local

# Server Port (Default: 8080)
PORT=8080

# Database Configuration
# Local SQLite default: sqlite:///./erequests_local.db
# Local Postgres: postgresql://dev:devpass@localhost:5432/erequests_local
# Cloud SQL Prod: postgresql+psycopg2://USER:PASS@/DB_NAME?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=sqlite:///./erequests_local.db

# Storage: 'local' (local file system) or 'gcs' (Google Cloud Storage)
STORAGE_TYPE=local
LOCAL_UPLOAD_DIR=./uploads
GCS_BUCKET_NAME=hrep-erequests-prod-storage

# Authentication Mode: 'mock' (local testing) or 'iap' (Google Cloud Identity-Aware Proxy)
AUTH_MODE=mock

# AI Agent (Optional for local testing; Heuristic parsing used if empty)
GEMINI_API_KEY=
